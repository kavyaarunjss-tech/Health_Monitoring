# Copy this file to ".env" (same folder) and fill in your own values. ".env" is git-ignored: never commit it.

# OpenAQ v3 API key (free account at https://explore.openaq.org) - live station data
OPENAQ_API_KEY=
# Optional: WAQI token (https://aqicn.org/data-platform/token/) - only used if its Karnataka feed is fresh
WAQI_TOKEN=
# Optional: data.gov.in API key - tested, the CPCB real-time resource did not answer
DATA_GOV_IN_API_KEY=

# E-mail alerts through Gmail (needs 2-Step Verification and an app password: https://myaccount.google.com/apppasswords)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Address that receives the daily "data feed stopped" notice and guest-mode e-mails
ALERT_EMAIL_TO=

# WhatsApp alerts through Twilio (https://console.twilio.com). Sandbox sender: whatsapp:+17372508034; each phone must first send
# 'join twilio-trial' to +1 737 250 8034 on WhatsApp, and only receives messages within 24 h of its last message to that number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Optional: send WhatsApp messages as an approved Content Template (needed on trial / business-initiated senders).
# TWILIO_WA_CONTENT_SID = the template id (HX...); TWILIO_WA_CONTENT_LAYOUT = aqi5 (our AQI template, 5 variables) or none (fixed template)
TWILIO_WA_CONTENT_SID=
TWILIO_WA_CONTENT_LAYOUT=

# Secret for login sessions; leave empty and the server generates one and adds it to .env on first start
AQI_SECRET_KEY=

# Web Push (phone notifications): create with  python backend/make_vapid_keys.py  (never share the private key)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional for a public tunnel: only answer these host names
# AQI_ALLOWED_HOSTS=localhost,127.0.0.1,*.trycloudflare.com
